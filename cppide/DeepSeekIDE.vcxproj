<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{E5375431-C3E2-4B6F-97E2-7E17C5921FAB}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <ProjectName>DeepSeekIDE</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <!-- Qt: QT6_DIR / Qt6_DIR сначала, потом авто-детект C:\Qt\6.x -->
  <PropertyGroup>
    <QtRoot Condition="'$(QT6_DIR)' != ''">$(QT6_DIR)</QtRoot>
    <QtRoot Condition="'$(QtRoot)' == '' and '$(Qt6_DIR)' != ''">$(Qt6_DIR)</QtRoot>
    <QtRoot Condition="'$(QtRoot)' == '' and Exists('C:\Qt\6.8.3\msvc2022_64')">C:\Qt\6.8.3\msvc2022_64</QtRoot>
    <QtRoot Condition="'$(QtRoot)' == '' and Exists('D:\Qt\6.8.3\msvc2022_64')">D:\Qt\6.8.3\msvc2022_64</QtRoot>
    <QtRoot Condition="'$(QtRoot)' == ''">C:\Qt\6.8.3\msvc2022_64</QtRoot>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
    <QtLibSuffix>d</QtLibSuffix>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
    <QtLibSuffix></QtLibSuffix>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(SolutionDir)out\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)out\$(Configuration)\int\</IntDir>
  </PropertyGroup>

  <PropertyGroup Label="ConfigurationDefault">
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>WIN32;_WINDOWS;UNICODE;_UNICODE;NOMINMAX;QT_CORE_LIB;QT_GUI_LIB;QT_WIDGETS_LIB;QT_NETWORK_LIB;QT_CORE5COMPAT_LIB;HAVE_CORE5COMPAT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>src;wasm3;$(QtRoot)\include;$(QtRoot)\include\QtCore;$(QtRoot)\include\QtGui;$(QtRoot)\include\QtWidgets;$(QtRoot)\include\QtNetwork;$(QtRoot)\include\QtCore5Compat;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EntryPointSymbol>mainCRTStartup</EntryPointSymbol>
      <AdditionalLibraryDirectories>$(QtRoot)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>Qt6Core$(QtLibSuffix).lib;Qt6Gui$(QtLibSuffix).lib;Qt6Widgets$(QtLibSuffix).lib;Qt6Network$(QtLibSuffix).lib;Qt6Core5Compat$(QtLibSuffix).lib;dwmapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>QT_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link><GenerateDebugInformation>true</GenerateDebugInformation></Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;QT_NO_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <!-- moc: заголовки с Q_OBJECT -->
  <ItemGroup>
    <CustomBuild Include="src\mainwindow.h">
      <FileType>Document</FileType>
      <Command>"$(QtRoot)\bin\moc.exe" "%(FullPath)" -o "$(IntDir)moc\moc_%(Filename).cpp"</Command>
      <Message>MOC %(Filename)%(Extension)</Message>
      <Outputs>$(IntDir)moc\moc_%(Filename).cpp</Outputs>
      <TreatOutputAsContent>false</TreatOutputAsContent>
    </CustomBuild>
    <CustomBuild Include="src\deepseekclient.h">
      <FileType>Document</FileType>
      <Command>"$(QtRoot)\bin\moc.exe" "%(FullPath)" -o "$(IntDir)moc\moc_%(Filename).cpp"</Command>
      <Message>MOC %(Filename)%(Extension)</Message>
      <Outputs>$(IntDir)moc\moc_%(Filename).cpp</Outputs>
    </CustomBuild>
    <CustomBuild Include="src\agent.h">
      <FileType>Document</FileType>
      <Command>"$(QtRoot)\bin\moc.exe" "%(FullPath)" -o "$(IntDir)moc\moc_%(Filename).cpp"</Command>
      <Message>MOC %(Filename)%(Extension)</Message>
      <Outputs>$(IntDir)moc\moc_%(Filename).cpp</Outputs>
    </CustomBuild>
    <CustomBuild Include="src\settings.h">
      <FileType>Document</FileType>
      <Command>"$(QtRoot)\bin\moc.exe" "%(FullPath)" -o "$(IntDir)moc\moc_%(Filename).cpp"</Command>
      <Message>MOC %(Filename)%(Extension)</Message>
      <Outputs>$(IntDir)moc\moc_%(Filename).cpp</Outputs>
    </CustomBuild>
    <CustomBuild Include="src\squirclecard.h">
      <FileType>Document</FileType>
      <Command>"$(QtRoot)\bin\moc.exe" "%(FullPath)" -o "$(IntDir)moc\moc_%(Filename).cpp"</Command>
      <Message>MOC %(Filename)%(Extension)</Message>
      <Outputs>$(IntDir)moc\moc_%(Filename).cpp</Outputs>
    </CustomBuild>
    <CustomBuild Include="src\sitepreview.h">
      <FileType>Document</FileType>
      <Command>"$(QtRoot)\bin\moc.exe" "%(FullPath)" -o "$(IntDir)moc\moc_%(Filename).cpp"</Command>
      <Message>MOC %(Filename)%(Extension)</Message>
      <Outputs>$(IntDir)moc\moc_%(Filename).cpp</Outputs>
    </CustomBuild>
  </ItemGroup>

  <!-- наши исходники -->
  <ItemGroup>
    <ClCompile Include="src\main.cpp" />
    <ClCompile Include="src\mainwindow.cpp" />
    <ClCompile Include="src\settings.cpp" />
    <ClCompile Include="src\pow.cpp" />
    <ClCompile Include="src\deepseekclient.cpp" />
    <ClCompile Include="src\agent.cpp" />
    <ClCompile Include="src\sessionstore.cpp" />
    <ClCompile Include="src\sitepreview.cpp" />
    <!-- сгенерированные moc -->
    <ClCompile Include="$(IntDir)moc\moc_mainwindow.cpp" />
    <ClCompile Include="$(IntDir)moc\moc_deepseekclient.cpp" />
    <ClCompile Include="$(IntDir)moc\moc_agent.cpp" />
    <ClCompile Include="$(IntDir)moc\moc_settings.cpp" />
    <ClCompile Include="$(IntDir)moc\moc_squirclecard.cpp" />
    <ClCompile Include="$(IntDir)moc\moc_sitepreview.cpp" />
  </ItemGroup>

  <!-- wasm3: вендоренный C, предупреждения выкручены в ноль -->
  <ItemGroup>
    <ClCompile Include="wasm3\m3_bind.c">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="wasm3\m3_code.c">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="wasm3\m3_compile.c">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="wasm3\m3_core.c">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="wasm3\m3_emit.c">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="wasm3\m3_env.c">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="wasm3\m3_exec.c">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="wasm3\m3_function.c">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="wasm3\m3_info.c">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="wasm3\m3_module.c">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="wasm3\m3_parse.c">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <Target Name="DeployQt" AfterTargets="Build">
    <Exec Command="&quot;$(QtRoot)\bin\windeployqt.exe&quot; --no-translations --no-system-d3d-compiler --no-opengl-sw &quot;$(TargetPath)&quot;" Condition="Exists('$(QtRoot)\bin\windeployqt.exe')" />
    <MakeDir Directories="$(OutDir)assets" />
    <Exec Command="xcopy /Y /I &quot;$(SolutionDir)assets&quot; &quot;$(OutDir)assets&quot;" Condition="Exists('$(SolutionDir)assets')" />
  </Target>
</Project>
